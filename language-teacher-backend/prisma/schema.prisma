datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Language {
  EN
  ES
  FR
  DE
}

enum Category {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}


enum Topic {
  FOOD
  TRAVEL
  FAMILY
  SURFING
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results ExerciseResult[]

  @@map("users")
}

model Exercise {
  id         String     @id @default(uuid())
  identifier String
  language   Language
  category   Category
  topic      Topic
  difficulty Difficulty
  sentence   String
  solution   String
  hint       String

  createdAt  DateTime @default(now())

  results ExerciseResult[]

  @@index([identifier])
  @@index([language])

  @@map("exercises")
}

model ExerciseResult {
  id          String   @id @default(uuid())

  userId      String
  exerciseId  String

  userAnswer  String
  isCorrect   Boolean

  durationSec Int?

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@index([userId])
  @@index([exerciseId])

  @@map("exercise_results")
}