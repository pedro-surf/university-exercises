generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  EN
  ES
  FR
  DE
  PT
  CZ
  NL
  IT
  ID
  JA
}

enum Category {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Topic {
  FOOD
  TRAVEL
  FAMILY
  SURFING
  WEATHER
  BUSINESS
  EMOTIONS
}

/// Subcategories that mirror the JSON asset folders
/// (vocabulary/* and grammar/*).
enum AssetCategory {
  // vocabulary
  FOOD
  TRAVEL
  EMOTIONS
  BUSINESS
  SURFING
  // grammar
  PRONOUNS
  ADJECTIVES
  ARTICLES
  ADVERBS
  CONJUNCTIONS
  VERBS
  PREPOSITIONS
  POSSESSIVES
}

/// How `Asset.icon` should be rendered by the client.
enum IconType {
  EMOJI
  FONT_AWESOME
  REACT_ICONS
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results              ExerciseResult[]
  assetTranslations    AssetTranslation[]
  exercises            Exercise[]

  @@map("users")
}

/// Canonical concept shared across languages (e.g. "bread", "to-be").
/// Icons live here so every translation of a word shares the same visual.
model Asset {
  id          String        @id @default(uuid())
  /// Stable key matching the current JSON `id` field.
  identifier  String
  /// VOCABULARY or GRAMMAR (LISTENING/READING unused for word assets).
  type        Category
  category    AssetCategory
  /// Emoji (🍞) or icon library key (e.g. "fa-bread-slice", "FaBreadSlice").
  icon        String?
  iconType    IconType?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations AssetTranslation[]

  @@unique([identifier, category])
  @@index([type, category])
  @@map("assets")
}

/// Per-language word for an asset. Teachers upsert rows here for missing translations.
model AssetTranslation {
  id          String   @id @default(uuid())
  assetId     String
  language    Language
  word        String
  /// Seeded/admin content starts approved; teacher submissions flip this to false.
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Teacher (or admin) who last wrote this translation.
  updatedById String?

  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([assetId, language])
  @@index([language])
  @@index([approved])
  @@index([updatedById])
  @@map("asset_translations")
}

model Exercise {
  id          String     @id @default(uuid())
  identifier  String
  language    Language
  category    Category
  topic       Topic
  difficulty  Difficulty
  sentence    String
  solution    String
  hint        String
  /// Seeded/admin content starts approved; teacher submissions flip this to false.
  approved    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  updatedById String?

  results   ExerciseResult[]
  updatedBy User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([identifier, language])
  @@index([identifier])
  @@index([language])
  @@index([approved])
  @@index([updatedById])

  @@map("exercises")
}

model ExerciseResult {
  id          String   @id @default(uuid())

  userId      String
  exerciseId  String

  userAnswer  String
  isCorrect   Boolean

  durationSec Int?

  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  exercise    Exercise @relation(fields: [exerciseId], references: [id])

  @@index([userId])
  @@index([exerciseId])

  @@map("exercise_results")
}